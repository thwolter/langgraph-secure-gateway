POSTGRES_PASSWORD=change-me
GATEWAY_PORT=8000

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
REFRESH_COOKIE_NAME=lgsg_refresh_token
# Use /api/auth when browser requests are proxied through a frontend route with that prefix.
REFRESH_COOKIE_PATH=/auth
# Use false for local HTTP development. Use true when serving the gateway over HTTPS.
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAMESITE=lax
ADMIN_SESSION_SECRET=replace-with-another-32-random-characters
AUTH_DB_AUTO_MIGRATE=true
GATEWAY_UPSTREAM_SECRET=replace-with-a-shared-gateway-to-langgraph-secret

# Comma-separated frontend origins allowed to call the gateway from a browser.
# Example: https://app.example.com,http://localhost:5173
CORS_ORIGINS=http://localhost:5173
