POSTGRES_PASSWORD=change-me
GATEWAY_PORT=8000

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
ADMIN_SESSION_SECRET=replace-with-another-32-random-characters
AUTH_DB_AUTO_MIGRATE=true

# Comma-separated frontend origins allowed to call the gateway from a browser.
# Example: https://app.example.com,http://localhost:5173
CORS_ORIGINS=http://localhost:5173
